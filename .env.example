# Copie para .env.local (gitignorado por padrão pelo Next.js) e preencha
# valores reais só se for rodar contra um backend diferente do default.

# URL do backend, usada pelas rotas app/api/* (BFF) rodando no servidor.
API_INTERNAL_URL=http://localhost:8080/api/v1

# URL do backend usada por qualquer chamada feita direto do browser
# (lib/api-client.ts). Só relevante se algo além do BFF chamar o backend.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
